# ==============================================================================
# COMERCIAL 360 · Variables de entorno de PRODUCCIÓN (plantilla)
# ==============================================================================
# Copia este archivo fuera del repositorio (por ejemplo como credencial
# "Secret file" de Jenkins) y rellena los valores. Nunca subas el real a git.
# ==============================================================================

# --- Aplicación ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Swagger (/api/docs) está apagado en producción salvo que se active aquí
SWAGGER_ENABLED=false

# --- Base de datos (PostgreSQL / Amazon RDS) ----------------------------------
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=comercial360_db
DATABASE_SSL=true
# CA de Amazon RDS incluida en la imagen del backend: verifica el certificado
DATABASE_SSL_CA=/usr/src/app/certs/rds-global-bundle.pem

# --- Autenticación (Better Auth) ----------------------------------------------
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Origen público de la app, sin ruta (https://comercial360.ejemplo.com)
BETTER_AUTH_URL=
# Orígenes permitidos para CORS y cookies (separados por coma). Normalmente el mismo de arriba.
FRONTEND_URL=

# --- Almacenamiento (Amazon S3) -----------------------------------------------
AWS_REGION=us-east-1
# Mismo bucket en las dos variables (evidencias de visita y respaldo de importaciones)
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET=
# Déjalas vacías si el servidor tiene un rol IAM con acceso al bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Correo para recuperar contraseña (HU-22, Amazon SES) ---------------------
# Con MAIL_FROM (remitente verificado en SES) se envía el correo por Amazon SES.
# Vacío: en producción no se envía nada (solo un aviso en el log, nunca el enlace).
# El rol IAM o las claves de arriba necesitan ses:SendEmail.
MAIL_FROM=
# Por defecto, la misma región de AWS_REGION
SES_REGION=

# --- Primer director (solo para el bootstrap, se puede borrar después) --------
BOOTSTRAP_DIRECTOR_NAME=Director Regional
BOOTSTRAP_DIRECTOR_EMAIL=
BOOTSTRAP_DIRECTOR_PASSWORD=

# --- Opcionales ---------------------------------------------------------------
# Geocodificación de clientes (OpenStreetMap Nominatim)
NOMINATIM_USER_AGENT=comercial360
# NestJS Observe: se activa solo si hay clave
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
