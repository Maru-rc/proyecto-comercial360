PORT=3001
NODE_ENV=development

# Base de datos RDS PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=comercial360_db
DATABASE_SSL=false

# BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Origen(es) del frontend permitidos para CORS y cookies (separados por coma)
FRONTEND_URL=http://localhost:5173,http://localhost:3001

# Seed de demostración (npm/pnpm run seed). Usa valores propios en tu .env local.
SEED_ASESOR_EMAIL=juan.perez@comercial360.com
SEED_ASESOR_PASSWORD=
SEED_DIRECTOR_EMAIL=richard.lopez@comercial360.com
SEED_DIRECTOR_PASSWORD=
# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET_NAME=comercial360-multimedia

# OpenStreetMap Nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org