# Copy to .env and fill in. Never commit the real file.

# --- Database (Amazon Aurora PostgreSQL in production) ---
DB_HOST=your-aurora-cluster-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=comercial360
DB_USER=
DB_PASSWORD=
DB_SSL=true

# --- betterAuth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://your-ec2-public-dns

# --- S3 (in EC2 prefer an IAM role: leave keys empty and S3_ENDPOINT unset) ---
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Geocoding ---
NOMINATIM_USER_AGENT=comercial360

# --- Frontend build args ---
VITE_API_URL=/api
VITE_ASSETS_URL=

# --- Entrypoint flags ---
RUN_MIGRATIONS=false
RUN_SEED=false
