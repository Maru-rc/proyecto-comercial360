PORT=3001
NODE_ENV=development

# Amazon Aurora PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=comercial360_db
DATABASE_SSL=false

# BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Allowed frontend origins for CORS and cookies (comma-separated)
FRONTEND_URL=http://localhost:5173,http://localhost:3001

# Demo seed (npm/pnpm run seed). Use custom values in your local .env.
SEED_ADVISOR_EMAIL=juan.perez@comercial360.com
SEED_ADVISOR_PASSWORD=
SEED_DIRECTOR_EMAIL=richard.lopez@comercial360.com
SEED_DIRECTOR_PASSWORD=
# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET_NAME=comercial360-multimedia

# OpenStreetMap Nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
